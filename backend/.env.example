# Copie para .env (local) ou cadastre no Railway. NUNCA versione o .env.
APP_ENV=development            # "production" liga todas as travas de segurança

# Banco: o MESMO Postgres da loja (Supabase). Pode colar a URL do Prisma como está.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Sessão: precisa ser IGUAL no Vercel e aqui, com 32+ caracteres aleatórios.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Dono: gere o hash com  python -m app.hash_password  (não use senha em texto puro)
OWNER_EMAIL=
OWNER_PASSWORD_HASH=

# Mercado Pago: a "assinatura secreta" do webhook (painel do Mercado Pago > Webhooks).
# Sem ela o webhook é RECUSADO (de propósito).
MP_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=

# E-mail (opcional; sem a chave, o e-mail só aparece no log)
RESEND_API_KEY=
EMAIL_FROM=NUTRI LAB BRASIL <no-reply@seudominio.com.br>

# Rede
TRUST_PROXY=true               # em produção (Railway/Vercel): usa o IP real do cliente nos limites
PUBLIC_BASE_URL=https://nutrilab-seven.vercel.app
CORS_ORIGINS=                  # vazio: o site chama a API pelo próprio domínio (rewrite do Next.js)
