# Banco de dados PostgreSQL
# DATABASE_URL = conexão com pool (usada pela aplicação)
# DIRECT_URL  = conexão direta (usada pelo Prisma em migrations)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nutrilab?schema=public"
DIRECT_URL="postgresql://usuario:senha@localhost:5432/nutrilab?schema=public"

# Autenticacao do proprietario
# Gere um segredo forte: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-bem-grande-e-aleatorio"
OWNER_EMAIL="dono@nutrilab.com.br"
OWNER_PASSWORD="nutrilab123"

# Mercado Pago (https://www.mercadopago.com.br/developers)
MP_ACCESS_TOKEN="APP_USR-xxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxx-xxxxxxxxx"
MP_WEBHOOK_SECRET="seu-secret-do-webhook"

# URL publica da aplicacao
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Email transacional (Resend - https://resend.com)
# Sem a chave, os emails sao apenas registrados no log (modo dev).
RESEND_API_KEY=""
EMAIL_FROM="NUTRI LAB BRASIL <no-reply@seudominio.com.br>"
